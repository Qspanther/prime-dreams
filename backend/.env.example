# ═════════════════════════════════════════════════════════════════
# 🏏 PRIME DREEMS — BACKEND PRODUCTION ENVIRONMENT CONFIGURATION
# ═════════════════════════════════════════════════════════════════

# Port (Render sets this automatically to 10000)
PORT=10000
NODE_ENV=production

# ─── EXTERNAL CLOUD DATABASE ───
# Connect to your external Cloud Database (Neon / Supabase / Railway / RDS)
# Example Neon: postgresql://neondb_owner:npg_xxx@ep-xxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
# Example Supabase: postgresql://postgres.xxx:password@aws-0-xxx.pooler.supabase.com:6543/postgres
# Leave empty or unset to fall back to local SQLite (primedreems.sqlite)
DATABASE_URL=

# SSL mode for Cloud PostgreSQL (true by default for Neon/Supabase)
DB_SSL=true

# ─── AUTH & SECURITY ───
JWT_SECRET=generate_a_very_secure_random_string_here_min_32_chars
BOT_API_KEY=c11_bot_mgr_sec_9938a7fbc21d49e

# ─── FRONTEND URL (For CORS & Origin validation) ───
# Point to your Render Frontend Web Service URL
FRONTEND_URL=https://prime-dreems-frontend.onrender.com

# ─── LIVE DATA CRICBUZZ API (Optional overrides) ───
# CRICBUZZ_API_KEY=your_key_here
