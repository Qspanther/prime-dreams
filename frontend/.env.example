# ═════════════════════════════════════════════════════════════════
# 🏏 PRIME DREEMS — FRONTEND PRODUCTION ENVIRONMENT CONFIGURATION
# ═════════════════════════════════════════════════════════════════

PORT=10000
NODE_ENV=production

# ─── BACKEND URL (Point to your Render Backend Web Service) ───
# Next.js Server-Side Rewrite Target:
BACKEND_URL=https://prime-dreems-backend.onrender.com

# Public Client-side API URL:
NEXT_PUBLIC_API_URL=https://prime-dreems-backend.onrender.com

# Public WebSocket URL for Real-Time Ball-by-Ball Streaming:
NEXT_PUBLIC_WEBSOCKET_URL=wss://prime-dreems-backend.onrender.com/ws
