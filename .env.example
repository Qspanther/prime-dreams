# ═════════════════════════════════════════════════════════════════
# 🏏 PRIME DREEMS — PRODUCTION ENVIRONMENT CONFIGURATION
# Optimized for Render Free Tier (512MB RAM) + Neon Free PostgreSQL
# ═════════════════════════════════════════════════════════════════

NODE_ENV=production
PORT=5000

# ─── 🐘 NEON FREE POSTGRESQL (POOLED CONNECTION) ───
# Use Neon pooled connection string with pgbouncer=true & sslmode=require
DATABASE_URL=postgresql://neondb_owner:your_password@ep-cool-resonance-123456-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require&pgbouncer=true
PG_POOL_MAX=5
DB_SSL=true

# ─── ⚡ REDIS CACHE (UPSTASH / RENDER KEY-VALUE) ───
# If unset, runs in-memory Map cache with TTL
REDIS_URL=

# ─── 📡 WEBSOCKET & HIGH CONCURRENCY GUARDS ───
MAX_WS_CONNECTIONS=500

# ─── 🏏 CRICBUZZ LIVE INGESTION WORKER ───
ENABLE_INGESTION=true
INGESTION_POLL_INTERVAL_MS=30000

# ─── 🔐 AUTH & SECURITY ───
JWT_SECRET=super_secure_random_jwt_secret_min_32_characters_here
BOT_API_KEY=c11_bot_mgr_sec_9938a7fbc21d49e
FRONTEND_URL=https://prime-dreems-frontend.onrender.com

# ─── 🌐 FRONTEND NEXT.JS CLIENT CONFIGURATION ───
BACKEND_URL=https://prime-dreems-backend.onrender.com
NEXT_PUBLIC_API_URL=https://prime-dreems-backend.onrender.com
NEXT_PUBLIC_WEBSOCKET_URL=wss://prime-dreems-backend.onrender.com/ws

# ─── 🤖 BOT SERVICE CONFIGURATION (port 5100) ───
BOT_SERVICE_PORT=5100
BOT_DATABASE_URL=postgresql://neondb_owner:your_password@ep-cool-resonance-123456-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require&pgbouncer=true
BOT_PG_POOL_MAX=3
BOT_MANAGER_KEY=c11_bot_mgr_sec_9938a7fbc21d49e
BOT_INTERVAL_MS=60000
BOT_MAX_ACTIVE=1000
BOT_BATCH_PER_TICK=5
